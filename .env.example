# .env.example
# Copy this file to .env and fill in the values.
# FastAPI server configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
# LOG_PATH=logs/app.log   # optional file path for rotating logs

# External services (leave empty for public GitHub repos)
GITHUB_TOKEN=
GROQ_API_KEY=

# SQLite database URL (relative path)
SQLITE_URL=sqlite:///./pr_copilot.db

